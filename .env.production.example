# Copy to /srv/portfolio/app/.env on the VPS, fill in the blanks, then chmod 600.
APP_NAME="Aiman Ismail"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portfolio.byaiman.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@byaiman.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=
ADMIN_NAME="Aiman Ismail"
ADMIN_PASSWORD=

# Host folder mounted as Laravel storage (uploads, logs).
STORAGE_PATH=/srv/portfolio/storage
